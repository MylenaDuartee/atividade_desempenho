<?xml version="1.0" encoding="UTF-8"?>
<!--
  Exemplo da Aula 2 - Testes funcionais com Selenium WebDriver + JUnit 5

  Pré-requisitos: JDK 17+, Maven 3.9+ e Google Chrome instalado.
  O Selenium Manager baixa o chromedriver correto automaticamente.
  Suba o sistema-alvo antes:  python ../../app/app.py

  Executar:            mvn test
  Sem janela:          mvn test -Dheadless=true
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>br.edu.es3</groupId>
  <artifactId>aula2-funcionalidades</artifactId>
  <version>1.0</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Se houver versões mais novas no Maven Central, pode atualizar -->
    <selenium.version>4.25.0</selenium.version>
    <junit.version>5.10.2</junit.version>
    <!-- valores padrão (podem ser trocados com -Dheadless=true -DbaseUrl=...) -->
    <headless>false</headless>
    <baseUrl>http://localhost:5000</baseUrl>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <systemPropertyVariables>
            <headless>${headless}</headless>
            <baseUrl>${baseUrl}</baseUrl>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
